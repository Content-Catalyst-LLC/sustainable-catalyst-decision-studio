# Example only. Production deploy generates a private file outside Git.
POSTGRES_DB=decision_studio
POSTGRES_USER=decision_studio
POSTGRES_PASSWORD=replace-with-a-long-random-secret
SCDS_DATABASE_URL=postgresql+psycopg://decision_studio:replace-with-a-long-random-secret@decision-studio-postgres:5432/decision_studio
SCDS_REPOSITORY_API_KEY=replace-with-a-separate-long-random-repository-secret

# v3.14 global authentication integration
SCDS_GLOBAL_AUTH_JWT_SECRET=replace-with-a-shared-global-auth-hmac-secret
SCDS_GLOBAL_AUTH_ISSUER=sustainable-catalyst-auth
SCDS_GLOBAL_AUTH_AUDIENCE=decision-studio
SCDS_SERVICE_API_KEYS={"replace-service-key":{"service_id":"service:example","scopes":["repository:read"]}}
