    },
    "sensitivity_analysis_id": {
      "type": "string"
    },
    "decision_id": {
      "type": "string"
    },
    "matrix_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "baseline_scores": {
      "type": "array"
    },
    "criterion_weight_sensitivity": {
      "type": "array"
    },
